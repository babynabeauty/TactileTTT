  <joint name="worldur7e_to_base" type="fixed">
    <parent link="world"/>
    <child link="platform_base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>

  <link name="Link_1"> </link>
  <joint name="platform_to_link1_joint" type="fixed">
    <origin xyz="0 0 0.9" rpy="0 0 0" />
    <parent link="platform_base_link" />
    <child link="Link_1" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- <link name="world"/> -->
  <joint name="platform2ur5_joint" type="fixed">
    <parent link="Link_1"/>
    <child link="base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>

  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <!-- <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/> -->
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

</robot>
